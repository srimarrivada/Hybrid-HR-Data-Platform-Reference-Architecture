        <mxCell id="bVKumJbvJyEJEweoQE7_-285" parent="bVKumJbvJyEJEweoQE7_-284" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#78909C;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" value="&lt;b&gt;🧪 Data quality&lt;/b&gt;&lt;hr&gt;• Platform 1: rule set with a blocking threshold before publish&lt;br&gt;• Platform 2: checks every cycle, alert only&lt;br&gt;• Row-count and threshold gates in ODS + curated store&lt;br&gt;• DQ scorecard dashboard reads results live" vertex="1">
          <mxGeometry height="130" width="555" x="10" y="44" as="geometry" />
        </mxCell>
        <mxCell id="bVKumJbvJyEJEweoQE7_-286" parent="bVKumJbvJyEJEweoQE7_-284" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#78909C;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" value="&lt;b&gt;🧬 Lineage&lt;/b&gt;&lt;hr&gt;• Source-to-target map + schema registry&lt;br&gt;• Model version history&lt;br&gt;• Append-only history + load boundaries&lt;br&gt;• Catalog lineage + table history in the lakehouse" vertex="1">
          <mxGeometry height="130" width="555" x="575" y="44" as="geometry" />
        </mxCell>
        <mxCell id="bVKumJbvJyEJEweoQE7_-287" parent="bVKumJbvJyEJEweoQE7_-284" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" value="&lt;b&gt;🔐 Access control&lt;/b&gt;&lt;hr&gt;• 3 sensitivity tiers · schema-level DENY&lt;br&gt;• Row-level security in BI models&lt;br&gt;• Catalog ACLs + workspace permissions&lt;br&gt;• Sensitive data never leaves Platform 1" vertex="1">
          <mxGeometry height="130" width="555" x="10" y="184" as="geometry" />
        </mxCell>
        <mxCell id="bVKumJbvJyEJEweoQE7_-288" parent="bVKumJbvJyEJEweoQE7_-284" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#78909C;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" value="&lt;b&gt;🚨 Incident handling&lt;/b&gt;&lt;hr&gt;• Batch + process audit, error logs&lt;br&gt;• Per-record status + trace in Platform 2&lt;br&gt;• Email alerts → ITSM ticket → support queue" vertex="1">
          <mxGeometry height="130" width="555" x="575" y="184" as="geometry" />
        </mxCell>
        <mxCell id="bVKumJbvJyEJEweoQE7_-289" parent="bVKumJbvJyEJEweoQE7_-268" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#455A64;fontColor=#FFFFFF;strokeColor=#263238;fontStyle=1;fontSize=15;align=left;spacingLeft=14;swimlaneFillColor=#F5F7F8;rounded=1;arcSize=1;collapsible=1;" value="OPERATIONS · ORCHESTRATION · CI/CD · MONITORING · DR" vertex="1">
