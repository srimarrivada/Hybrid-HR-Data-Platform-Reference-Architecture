          <mxGeometry height="130" width="555" x="10" y="44" as="geometry" />
        </mxCell>
        <mxCell id="bVKumJbvJyEJEweoQE7_-291" parent="bVKumJbvJyEJEweoQE7_-289" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#78909C;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" value="&lt;b&gt;🚀 CI/CD&lt;/b&gt;&lt;hr&gt;• Git → pipeline → dev → test → prod with a manual gate&lt;br&gt;• One commit promoted to every ODS replica&lt;br&gt;• Same notebooks per environment, only config changes&lt;br&gt;• Fast rollback on both platforms" vertex="1">
          <mxGeometry height="130" width="555" x="575" y="44" as="geometry" />
        </mxCell>
        <mxCell id="bVKumJbvJyEJEweoQE7_-292" parent="bVKumJbvJyEJEweoQE7_-289" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#78909C;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" value="&lt;b&gt;📊 Monitoring&lt;/b&gt;&lt;hr&gt;• Scheduler console + load-count metrics DB&lt;br&gt;• Job run logs + hourly monitor jobs&lt;br&gt;• Alerts → ITSM escalation" vertex="1">
          <mxGeometry height="130" width="555" x="10" y="184" as="geometry" />
        </mxCell>
