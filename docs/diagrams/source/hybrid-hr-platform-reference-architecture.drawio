        </mxCell>
        <mxCell id="bVKumJbvJyEJEweoQE7_-73" parent="bVKumJbvJyEJEweoQE7_-69" style="shape=step;perimeter=stepPerimeter;size=0.08;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=2;fontSize=10;" value="&lt;b&gt;④ ODS deploy&lt;/b&gt;&lt;br&gt;stored-procedure transforms" vertex="1">
          <mxGeometry height="56" width="190" x="568" y="50" as="geometry" />
        </mxCell>
        <mxCell id="bVKumJbvJyEJEweoQE7_-74" parent="bVKumJbvJyEJEweoQE7_-69" style="shape=step;perimeter=stepPerimeter;size=0.08;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;strokeWidth=2;fontSize=10;" value="&lt;b&gt;⑤ CDC load&lt;/b&gt;&lt;br&gt;snapshot → delta → upsert" vertex="1">
          <mxGeometry height="56" width="190" x="754" y="50" as="geometry" />
        </mxCell>
        <mxCell id="bVKumJbvJyEJEweoQE7_-75" parent="bVKumJbvJyEJEweoQE7_-69" style="shape=step;perimeter=stepPerimeter;size=0.08;whiteSpace=wrap;html=1;fillColor=#D0CEE2;strokeColor=#56517E;strokeWidth=2;fontSize=10;" value="&lt;b&gt;⑥ Postload&lt;/b&gt;&lt;br&gt;advance window on success" vertex="1">
          <mxGeometry height="56" width="190" x="940" y="50" as="geometry" />
        </mxCell>
        <mxCell id="bVKumJbvJyEJEweoQE7_-76" parent="bVKumJbvJyEJEweoQE7_-69" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E07A00;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;API extraction&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;• Per worker domain: incremental · effective-dated · future-dated pulls&lt;br&gt;• Reference + custom-report workflows&lt;br&gt;• Window = last success − overlap buffer (eventual consistency)&lt;br&gt;• Staggered to respect API connection limits&lt;br&gt;• Hierarchical XML → PK/FK tables, no business logic" vertex="1">
          <mxGeometry height="170" width="363" x="10" y="120" as="geometry" />
        </mxCell>
        <mxCell id="bVKumJbvJyEJEweoQE7_-77" parent="bVKumJbvJyEJEweoQE7_-69" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E8B7A;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;File extraction&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;• Vendor files via SFTP / MFT, key auth, retries&lt;br&gt;• Timestamped archive · stale-file rejection&lt;br&gt;• Ordered loads where totals depend on each other&lt;br&gt;• Run-log idempotency for cumulative feeds&lt;br&gt;• Restricted feed: atomic replace, a failed load keeps prior data" vertex="1">
          <mxGeometry height="170" width="363" x="383" y="120" as="geometry" />
        </mxCell>
        <mxCell id="bVKumJbvJyEJEweoQE7_-78" parent="bVKumJbvJyEJEweoQE7_-69" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#56517E;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Orchestration&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;text-align: center;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;• Enterprise scheduler: a small number of anchor jobs start on a clock, everything else on dependency&lt;/span&gt;&lt;/div&gt;• Scheduler job → orchestrator → wrapper → ETL session&lt;br&gt;• Config-driven dependency graph (chains · fan-out · gates)&lt;br&gt;• Pause / retry / resume flags · run audit&lt;br&gt;• Completion time moves with daily change volume" vertex="1">
          <mxGeometry height="170" width="374" x="756" y="120" as="geometry" />
        </mxCell>
        <mxCell id="bVKumJbvJyEJEweoQE7_-79" parent="bVKumJbvJyEJEweoQE7_-69" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F1F8EE;strokeColor=#82B366;strokeWidth=2;fontSize=10;align=left;spacingLeft=10;" value="&lt;b&gt;State control:&lt;/b&gt;&amp;nbsp;The extraction window only advances when every job succeeds. A failed night re-runs the same window → &lt;b&gt;no data gaps&lt;/b&gt;. Only the daily delta (a small share of rows) reaches the load step" vertex="1">
          <mxGeometry height="56" width="1120" x="10" y="300" as="geometry" />
        </mxCell>
        <mxCell id="bVKumJbvJyEJEweoQE7_-80" parent="bVKumJbvJyEJEweoQE7_-69" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#555555;spacingLeft=10;" value="Transform detail → Storage row · CDC detail → Processing row" vertex="1">
          <mxGeometry height="40" width="1120" x="10" y="366" as="geometry" />
        </mxCell>
