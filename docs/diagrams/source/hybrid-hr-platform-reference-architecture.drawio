        <mxCell id="bVKumJbvJyEJEweoQE7_-265" parent="bVKumJbvJyEJEweoQE7_-264" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;PLATFORM 1: BI semantic model on the Warehouse&lt;/b&gt;&lt;hr&gt;• Composite model: Imported dimensions + aggregates, DirectQuery for large or highly restricted facts&lt;br&gt;• Row-level security roles on top of schema security&lt;br&gt;• Import refresh triggered when the DW publishes, not on a fixed clock&lt;br&gt;• Broad HR audience consumes headcount, attrition, leave, mobility, planning, executive summary" vertex="1">
          <mxGeometry height="140" width="1140" x="10" y="44" as="geometry" />
        </mxCell>
        <mxCell id="bVKumJbvJyEJEweoQE7_-266" parent="bVKumJbvJyEJEweoQE7_-264" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E07A00;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;PLATFORM 2: Dashboards on the Lakehouse Gold layer&lt;/b&gt;&lt;hr&gt;• Live ops dashboard: Every click queries Gold views (minutes-old data)&lt;br&gt;• Business dashboards import Gold on a staggered schedule to avoid warehouse contention&lt;br&gt;• Each refresh starts after the upstream cycle it depends on&lt;br&gt;• Federated context read once per refresh, not per click" vertex="1">
